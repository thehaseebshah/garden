<script>
    document.addEventListener('DOMContentLoaded', init, false);
    document.addEventListener('DOMContentLoaded', setCorrectShortcut, false);

    // Preview content cache
    const previewCache = new Map();

    // ===== Escaping Utilities =====
    // Everything that comes from the URL, the search box or the search index is
    // treated as text and escaped before it is put into the DOM.

    function escapeHtml(str) {
        return String(str == null ? '' : str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function decodeHtml(str) {
        if (!str) return '';
        // DOMParser does not run scripts or load resources.
        return new DOMParser().parseFromString(str, 'text/html').documentElement.textContent;
    }

    function escapeRegex(str) {
        return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    // ===== Lazy Loading =====
    // The search library and index are only downloaded the first time search is used.

    let indexPromise = null;

    function loadScript(src, integrity) {
        return new Promise((resolve, reject) => {
            const s = document.createElement('script');
            s.src = src;
            s.integrity = integrity;
            s.crossOrigin = 'anonymous';
            s.referrerPolicy = 'no-referrer';
            s.onload = resolve;
            s.onerror = () => reject(new Error('Failed to load ' + src));
            document.head.appendChild(s);
        });
    }

    function ensureIndex() {
        if (!indexPromise) {
            indexPromise = Promise.all([
                typeof FlexSearch === 'undefined'
                    ? loadScript('https://cdn.jsdelivr.net/npm/flexsearch@0.7.21/dist/flexsearch.bundle.js', 'sha384-ZflVYmoWn2YFWaz5Cw6NjprAqYTmiAy9XLVm29qbq7WCC2GzO1RjWvQZ9YIlJm+m')
                    : Promise.resolve(),
                fetch('/searchIndex.json?v={{meta.buildDate|isoDate}}').then(r => r.json())
            ]).then(([, docs]) => {
                window.docs = docs;
                window.index = createIndex(docs);
                return window.index;
            }).catch((error) => {
                // Allow a retry the next time search is opened.
                indexPromise = null;
                throw error;
            });
        }
        return indexPromise;
    }

    // ===== Open / Close =====

    let lastFocused = null;

    function isSearchOpen() {
        const searchContainer = document.getElementById('globalsearch');
        return searchContainer && searchContainer.classList.contains('active');
    }

    function openSearch() {
        const searchContainer = document.getElementById('globalsearch');
        if (!searchContainer || isSearchOpen()) return;
        lastFocused = document.activeElement;
        searchContainer.classList.add('active');
        searchContainer.setAttribute('aria-hidden', 'false');
        document.querySelectorAll('.search-button').forEach(b => b.setAttribute('aria-expanded', 'true'));
        document.getElementById('term').focus();
        ensureIndex().catch((error) => console.error('Failed to load search index:', error));
    }

    function closeSearch() {
        const searchContainer = document.getElementById('globalsearch');
        if (!searchContainer || !isSearchOpen()) return;
        searchContainer.classList.remove('active');
        searchContainer.setAttribute('aria-hidden', 'true');
        document.querySelectorAll('.search-button').forEach(b => b.setAttribute('aria-expanded', 'false'));
        if (lastFocused && typeof lastFocused.focus === 'function') {
            lastFocused.focus();
        }
    }

    window.toggleSearch = function () {
        if (isSearchOpen()) {
            closeSearch();
        } else {
            openSearch();
        }
    }

    window.toggleTagSearch = function (evt) {
        const term = evt.textContent;
        if (term) {
            document.getElementById('term').value = term.trim();
            openSearch();
            window.search();
        }
    }

    const loadingSvg = `
    <div style="display: flex; justify-content: center; padding: 40px;" role="status" aria-label="Loading">
        <svg width="40" height="40" viewBox="0 0 45 45" xmlns="http://www.w3.org/2000/svg" stroke="currentColor" aria-hidden="true">
            <g fill="none" fill-rule="evenodd" transform="translate(1 1)" stroke-width="2">
                <circle cx="22" cy="22" r="6" stroke-opacity="0">
                    <animate attributeName="r" begin="1.5s" dur="3s" values="6;22" calcMode="linear" repeatCount="indefinite" />
                    <animate attributeName="stroke-opacity" begin="1.5s" dur="3s" values="1;0" calcMode="linear" repeatCount="indefinite" />
                    <animate attributeName="stroke-width" begin="1.5s" dur="3s" values="2;0" calcMode="linear" repeatCount="indefinite" />
                </circle>
                <circle cx="22" cy="22" r="6" stroke-opacity="0">
                    <animate attributeName="r" begin="3s" dur="3s" values="6;22" calcMode="linear" repeatCount="indefinite" />
                    <animate attributeName="stroke-opacity" begin="3s" dur="3s" values="1;0" calcMode="linear" repeatCount="indefinite" />
                    <animate attributeName="stroke-width" begin="3s" dur="3s" values="2;0" calcMode="linear" repeatCount="indefinite" />
                </circle>
                <circle cx="22" cy="22" r="8">
                    <animate attributeName="r" begin="0s" dur="1.5s" values="6;1;2;3;4;5;6" calcMode="linear" repeatCount="indefinite" />
                </circle>
            </g>
        </svg>
    </div>`;

    function debounce(func, wait, immediate) {
        var timeout;
        return function () {
            var context = this, args = arguments;
            var later = function () {
                timeout = null;
                if (!immediate) func.apply(context, args);
            };
            var callNow = immediate && !timeout;
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
            if (callNow) func.apply(context, args);
        };
    }

    function setCorrectShortcut() {
        if (navigator.platform.toUpperCase().indexOf('MAC') >= 0) {
            document.querySelectorAll(".search-keys").forEach(x => x.textContent = "⌘K");
        }
    }

    // ===== Highlighting Utilities =====

    function tokenizeSearchTerms(query) {
        const terms = [];
        const regex = /"([^"]+)"|(\S+)/g;
        let match;
        while ((match = regex.exec(query)) !== null) {
            const term = (match[1] || match[2]).toLowerCase();
            if (term.length > 1) {
                terms.push(term);
            }
        }
        return terms.sort((a, b) => b.length - a.length);
    }

    // Takes plain text and returns escaped HTML with the search terms wrapped.
    function highlightTerms(text, terms) {
        if (!text) return '';
        if (!terms || terms.length === 0) return escapeHtml(text);
        const regex = new RegExp(`(${terms.map(escapeRegex).join('|')})`, 'gi');
        // With a capture group, split() puts the matches at the odd indexes.
        return String(text).split(regex).map((part, i) =>
            i % 2 === 1
                ? `<span class="search-highlight">${escapeHtml(part)}</span>`
                : escapeHtml(part)
        ).join('');
    }

    function getContextualExcerpt(content, terms, maxLength = 150) {
        if (!content) return '';
        const plainText = decodeHtml(content.replace(/<[^>]*>/g, ''));

        if (!terms || terms.length === 0) {
            return truncateText(plainText, maxLength);
        }

        let firstMatchIndex = plainText.length;
        terms.forEach(term => {
            const index = plainText.toLowerCase().indexOf(term.toLowerCase());
            if (index !== -1 && index < firstMatchIndex) {
                firstMatchIndex = index;
            }
        });

        if (firstMatchIndex === plainText.length) {
            return truncateText(plainText, maxLength);
        }

        const contextBefore = 50;
        const start = Math.max(0, firstMatchIndex - contextBefore);
        const end = Math.min(plainText.length, start + maxLength);

        let excerpt = plainText.substring(start, end);
        if (start > 0) excerpt = '...' + excerpt;
        if (end < plainText.length) excerpt = excerpt + '...';

        return excerpt;
    }

    function truncateText(str, size) {
        if (!str) return '';
        if (str.length <= size) return str;
        return str.substring(0, size - 3) + '...';
    }

    // ===== Preview Functions =====

    async function fetchPreviewContent(url) {
        if (previewCache.has(url)) {
            return previewCache.get(url);
        }

        try {
            const response = await fetch(url);
            const html = await response.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');

            const content = doc.querySelector('.content, .cm-s-obsidian, article, main');
            if (content) {
                // Scripts never run here anyway; the title is shown separately above the preview,
                // and the inline table of contents is just noise in a preview.
                content.querySelectorAll('script, header h1, .toc-inline').forEach(el => el.remove());
            }
            const htmlContent = content ? content.innerHTML : '';
            previewCache.set(url, htmlContent);
            return htmlContent;
        } catch (error) {
            console.error('Failed to fetch preview:', error);
            return '';
        }
    }

    function highlightTextNodes(element, terms) {
        if (!terms || terms.length === 0) return;

        const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, null, false);
        const textNodes = [];

        while (walker.nextNode()) {
            textNodes.push(walker.currentNode);
        }

        textNodes.forEach(node => {
            const text = node.textContent;
            const lower = text.toLowerCase();
            const hasMatch = terms.some(term => lower.includes(term.toLowerCase()));

            if (hasMatch) {
                const span = document.createElement('span');
                // highlightTerms escapes the text, so decoded entities stay text.
                span.innerHTML = highlightTerms(text, terms);
                node.parentNode.replaceChild(span, node);
            }
        });
    }

    function tagsToHtml(tags, className, clickable) {
        if (!tags || tags.length === 0) return '';
        return `<div class="${className}">${tags.map(tag => clickable
            ? `<button type="button" class="tag" onclick="toggleTagSearch(this)">#${escapeHtml(tag)}</button>`
            : `<span class="tag">#${escapeHtml(tag)}</span>`).join('')}</div>`;
    }

    let previewRequest = 0;

    async function showPreview(index) {
        const results = window.searchResults;
        if (!results || !results[index]) return;

        const result = results[index];
        const previewPanel = document.getElementById('search-preview');
        const previewContent = document.getElementById('preview-content');
        if (!previewPanel || !previewContent) return;
        const placeholder = previewPanel.querySelector('.preview-placeholder');

        setActiveResult(index);

        // Show loading state in preview
        previewContent.innerHTML = loadingSvg;
        previewContent.classList.add('has-content');
        if (placeholder) placeholder.style.display = 'none';

        // Ignore responses that arrive after a newer preview was requested.
        const request = ++previewRequest;
        const htmlContent = await fetchPreviewContent(result.url);
        if (request !== previewRequest) return;

        previewContent.innerHTML = `
            <div class="preview-title">${highlightTerms(decodeHtml(result.title), window.searchTerms)}</div>
            ${tagsToHtml(result.tags, 'preview-tags', true)}
            <div class="preview-body">${htmlContent}</div>
        `;

        // Highlight search terms in the preview body
        const previewBody = previewContent.querySelector('.preview-body');
        if (previewBody && window.searchTerms) {
            highlightTextNodes(previewBody, window.searchTerms);
        }

        window.currentPreviewIndex = index;
    }

    function setActiveResult(index) {
        document.querySelectorAll('.searchresult').forEach(el => {
            const isActive = parseInt(el.dataset.index) === index;
            el.classList.toggle('active', isActive);
            el.setAttribute('aria-selected', isActive ? 'true' : 'false');
            if (isActive) {
                document.getElementById('term').setAttribute('aria-activedescendant', el.id);
            }
        });
    }

    function hidePreview() {
        const previewPanel = document.getElementById('search-preview');
        const previewContent = document.getElementById('preview-content');
        const placeholder = previewPanel?.querySelector('.preview-placeholder');

        previewRequest++;
        if (placeholder) placeholder.style.display = 'flex';
        if (previewContent) {
            previewContent.classList.remove('has-content');
            previewContent.innerHTML = '';
        }
        window.currentPreviewIndex = -1;
    }

    // ===== FlexSearch Index =====

    function createIndex(posts) {
        const encoder = (str) => str.toLowerCase().split(/([^a-z]|[^\x00-\x7F])/);
        const contentIndex = new FlexSearch.Document({
            cache: true,
            charset: "latin:extra",
            optimize: true,
            index: [
                { field: "content", tokenize: "reverse", encode: encoder },
                { field: "title", tokenize: "forward", encode: encoder },
                { field: "tags", tokenize: "forward", encode: encoder }
            ]
        });
        posts.forEach((p, idx) => {
            contentIndex.add({ id: idx, title: p.title, content: p.content, tags: p.tags });
        });
        return contentIndex;
    }

    // ===== Initialization =====

    function init() {
        const searchContainer = document.getElementById('globalsearch');
        window.field = document.querySelector('#term');
        window.resultsDiv = document.querySelector('#search-results');
        if (!searchContainer || !field || !resultsDiv) return;

        // Keyboard shortcuts
        document.addEventListener('keydown', (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                e.preventDefault();
                toggleSearch();
                return;
            }

            if (!isSearchOpen()) return;

            if (e.key === 'Escape') {
                e.preventDefault();
                closeSearch();
                return;
            }

            // Keep keyboard focus inside the open dialog.
            if (e.key === 'Tab') {
                const focusable = [...searchContainer.querySelectorAll('input, button, a[href], [tabindex]:not([tabindex="-1"])')]
                    .filter(el => el.offsetParent !== null);
                if (focusable.length === 0) return;
                const first = focusable[0];
                const last = focusable[focusable.length - 1];
                if (e.shiftKey && document.activeElement === first) {
                    e.preventDefault();
                    last.focus();
                } else if (!e.shiftKey && document.activeElement === last) {
                    e.preventDefault();
                    first.focus();
                } else if (!searchContainer.contains(document.activeElement)) {
                    e.preventDefault();
                    first.focus();
                }
                return;
            }

            // Navigate search results with arrow keys
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                navigateResults(1);
            }
            if (e.key === 'ArrowUp') {
                e.preventDefault();
                navigateResults(-1);
            }
            if (e.key === 'Enter' && document.activeElement === field) {
                e.preventDefault();
                const active = document.querySelector('.searchresult.active');
                if (active) {
                    const url = active.dataset.url;
                    if (url) window.location.href = url;
                }
            }
        });

        function navigateResults(direction) {
            const results = document.querySelectorAll('.searchresult');
            if (results.length === 0) return;

            let currentIndex = -1;
            results.forEach((el, i) => {
                if (el.classList.contains('active')) {
                    currentIndex = i;
                }
            });

            let newIndex;
            if (currentIndex === -1) {
                newIndex = direction > 0 ? 0 : results.length - 1;
            } else {
                newIndex = currentIndex + direction;
                if (newIndex < 0) newIndex = results.length - 1;
                if (newIndex >= results.length) newIndex = 0;
            }

            results[newIndex].scrollIntoView({ behavior: 'smooth', block: 'nearest' });

            // Sync preview with selection
            showPreview(parseInt(results[newIndex].dataset.index));
        }

        // Clicking the backdrop closes the dialog; clicks inside the box do not.
        searchContainer.addEventListener('click', (e) => {
            if (e.target === searchContainer) closeSearch();
        });

        // Result list interactions (no inline handlers, so URLs never end up in JS strings).
        resultsDiv.addEventListener('mouseover', (e) => {
            const result = e.target.closest('.searchresult');
            if (result && !result.classList.contains('active')) {
                showPreview(parseInt(result.dataset.index));
            }
        });
        resultsDiv.addEventListener('click', (e) => {
            const result = e.target.closest('.searchresult');
            if (result && !e.target.closest('a')) {
                window.location.href = result.dataset.url;
            }
        });

        const debouncedSearch = debounce(search, 200, false);
        // "input" also covers paste, cut, autocomplete and the clear button.
        field.addEventListener('input', debouncedSearch);

        const params = new URL(location.href).searchParams;
        if (params.get('q')) {
            field.value = params.get('q');
            openSearch();
            search();
        }
    }

    // ===== Search Function =====

    window.lastSearch = '';
    window.searchResults = [];
    window.searchTerms = [];
    window.currentPreviewIndex = -1;

    async function search() {
        const searchQuery = field.value.trim();
        const searchLayout = document.getElementById('search-layout');

        if (!searchQuery) {
            window.lastSearch = '';
            resultsDiv.innerHTML = '';
            hidePreview();
            if (searchLayout) searchLayout.classList.add('no-preview');
            return;
        }
        if (searchQuery === lastSearch) return;

        window.lastSearch = searchQuery;
        window.searchTerms = tokenizeSearchTerms(searchQuery);

        resultsDiv.innerHTML = loadingSvg;
        hidePreview();

        try {
            await ensureIndex();
        } catch (error) {
            window.lastSearch = '';
            resultsDiv.innerHTML = `<div class="no-results"><p>Search is unavailable right now. Please try again.</p></div>`;
            return;
        }
        // The query may have changed while the index was loading.
        if (searchQuery !== field.value.trim()) return;

        const results = offlineSearch(searchQuery);
        window.searchResults = results;

        if (!results.length) {
            if (searchLayout) searchLayout.classList.add('no-preview');
            resultsDiv.innerHTML = `
                <div class="no-results" role="status">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        <line x1="8" y1="11" x2="14" y2="11"></line>
                    </svg>
                    <p>{{ meta.uiStrings.searchNoResults }} "${escapeHtml(searchQuery)}"</p>
                </div>
            `;
            return;
        }

        // Show preview panel when we have results
        if (searchLayout) searchLayout.classList.remove('no-preview');

        let resultsHTML = '';
        results.forEach((r, index) => {
            const excerpt = getContextualExcerpt(r.content, window.searchTerms, 120);
            resultsHTML += `
                <div class="searchresult${index === 0 ? ' active' : ''}"
                     id="search-result-${index}"
                     role="option"
                     aria-selected="${index === 0 ? 'true' : 'false'}"
                     data-index="${index}"
                     data-url="${escapeHtml(r.url)}">
                    <a class="result-title" href="${escapeHtml(r.url)}" tabindex="-1">${highlightTerms(decodeHtml(r.title), window.searchTerms)}</a>
                    ${tagsToHtml(r.tags, 'result-tags', false)}
                    <div class="result-excerpt">${highlightTerms(excerpt, window.searchTerms)}</div>
                </div>
            `;
        });

        resultsDiv.innerHTML = resultsHTML;

        // Auto-show preview for first result
        showPreview(0);
    }

    window.search = search;

    // ===== Offline Search =====

    function offlineSearch(searchQuery) {
        const data = window.docs;
        const isTagSearch = searchQuery[0] === "#" && searchQuery.length > 1;

        const searchResults = isTagSearch
            ? index.search(searchQuery.substring(1), [{ field: "tags" }])
            : index.search(searchQuery, [
                { field: "title", limit: 5 },
                { field: "content", limit: 10 }
            ]);

        const getByField = (field) => {
            const results = searchResults.filter((x) => x.field === field);
            if (results.length === 0) return [];
            return [...results[0].result];
        };

        const allIds = new Set([
            ...getByField("title"),
            ...getByField("content"),
            ...getByField("tags")
        ]);

        const dataIds = [...allIds];
        const finalResults = dataIds.map((id) => {
            const result = { ...data[id] };
            result.tags = result.tags.filter((x) => x !== "gardenEntry" && x !== "note");
            return result;
        });

        return finalResults;
    }
</script>
