    <script>
      // Highlight the element the URL fragment points at. Fragments that don't
      // match an element (or aren't valid ids) are ignored instead of throwing.
      function getReferredElement(hash) {
        if (!hash) return null;
        try {
          return document.getElementById(decodeURIComponent(hash));
        } catch {
          // Malformed percent-encoding in the URL; nothing to highlight.
          return null;
        }
      }
      const initialRef = getReferredElement(window.location.hash.slice(1));
      if (initialRef) {
        initialRef.classList.add('referred');
      }
      window.addEventListener('hashchange', (evt) => {
        const oldRef = getReferredElement(evt.oldURL.split("#")[1]);
        if (oldRef) {
          oldRef.classList.remove('referred');
        }
        const newRef = getReferredElement(evt.newURL.split("#")[1]);
        if (newRef) {
          newRef.classList.add('referred');
        }
      }, false);
      const url = window.location.href.split("#")[0];
      document.querySelectorAll(".cm-s-obsidian > *[id]").forEach(function (el) {
        el.ondblclick = function(evt) {
          if (!navigator.clipboard) return;
          const ref_url = url + '#' + evt.target.id
          navigator.clipboard.writeText(ref_url).catch(() => {
            // Clipboard access can be denied by the browser; copying is a convenience only.
          });
        }
      });
    </script>
