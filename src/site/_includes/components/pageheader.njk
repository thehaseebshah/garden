<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{%- set pageTitle = title or noteTitle or page.fileSlug -%}
{%- set pageDescription = description or ((noteContent or content) | hideDataview | link | metaDescription) -%}
{%- if pageDescription %}
<meta name="description" content="{{ pageDescription }}">
{%- endif %}
{%- if meta.siteBaseUrl %}
<link rel="canonical" href="{{ meta.siteBaseUrl }}{{ page.url }}">
<meta property="og:url" content="{{ meta.siteBaseUrl }}{{ page.url }}">
<link rel="alternate" type="application/atom+xml" title="{{ meta.siteName }}" href="/feed.xml">
{%- endif %}
<meta property="og:type" content="{% if page.url == '/' %}website{% else %}article{% endif %}">
<meta property="og:site_name" content="{{ meta.siteName }}">
<meta property="og:title" content="{{ pageTitle }}">
{%- if pageDescription %}
<meta property="og:description" content="{{ pageDescription }}">
{%- endif %}
{%- if meta.siteBaseUrl %}
<meta property="og:image" content="{{ meta.siteBaseUrl }}/img/og-default.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ meta.siteName }}: a digital garden of ideas, research, projects and notes">
<meta name="twitter:card" content="summary_large_image">
{%- else %}
<meta name="twitter:card" content="summary">
{%- endif %}
<meta name="theme-color" content="#0a120d">

<script async src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.25.0/prism.min.js" integrity="sha512-hpZ5pDCF2bRCweL5WoA0/N1elet1KYL5mx3LP555Eg/0ZguaHawxNvEjF6O3rufAChs16HVNhEc6blF/rZoowQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script async src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.25.0/plugins/autoloader/prism-autoloader.min.js" integrity="sha512-sv0slik/5O0JIPdLBCR2A3XDg/1U3WuDEheZfI/DI5n8Yqc3h5kjrnr46FGBNiUAJF7rE4LHKwQ/SoSLRKAxEA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

{%include "components/calloutScript.njk"%}

{# Mermaid is ~1 MB, so it is only downloaded on pages that contain a diagram. #}
<script>
    document.addEventListener("DOMContentLoaded", () => {
        if (!document.querySelector("pre.mermaid")) return;
        const s = document.createElement("script");
        s.src = "https://cdn.jsdelivr.net/npm/mermaid@10.9.1/dist/mermaid.min.js";
        s.integrity = "sha384-WmdflGW9aGfoBdHc4rRyWzYuAjEmDwMdGdiPNacbwfGKxBW/SO6guzuQ76qjnSlr";
        s.crossOrigin = "anonymous";
        s.onload = () => mermaid.run({ querySelector: "pre.mermaid" });
        document.head.appendChild(s);
    });
</script>

{%- if settings.dgShowLocalGraph === true %}
<script defer src="/scripts/vendor/force-graph.min.js"></script>
{%- endif %}
{%- if settings.dgShowLocalGraph === true or settings.dgShowFileTree === true %}
<script defer src="/scripts/vendor/alpine-persist.min.js"></script>
<script defer src="/scripts/vendor/alpine.min.js"></script>
{%- endif %}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.25.0/themes/prism-okaidia.min.css" integrity="sha512-mIs9kKbaw6JZFfSuo+MovjU+Ntggfoj8RwAmJbVXQ5mkAX5LlgETQEweFPI18humSPHymTb5iikEOKWF7I8ncQ==" crossorigin="anonymous" referrerpolicy="no-referrer"/>

<link rel="preload" href="/fonts/product-sans/Product Sans Regular.woff2" as="font" type="font/woff2" crossorigin>
{%-if meta.themeStyle%}
    <link href="/styles/obsidian-base.css" rel="stylesheet">
    <link href="{{meta.themeStyle}}" rel="stylesheet">
{% else %}
    <link href="/styles/style.css?v={{meta.styleVersion}}" rel="stylesheet">
{%endif%}
<link href="/styles/digital-garden-base.css?v={{meta.styleVersion}}" rel="stylesheet">

<link href="/styles/custom-style.css?v={{meta.styleVersion}}" rel="stylesheet">
{%- for style in dynamics.styles -%}
<link href="{{style}}?v={{meta.styleVersion}}" rel="stylesheet">
{%- endfor -%}

{% favicons './src/site/favicon.svg', appleIconBgColor='#0a120d' %}

{% if metatags %}
    {% for name, content in metatags %}
        <meta name="{{ name }}" content="{{ content }}">
    {% endfor %}
{% endif %}

{% if meta.styleSettingsCss %}
    <style>
        {{ meta.styleSettingsCss | safe }}
    </style>
{% endif %}
